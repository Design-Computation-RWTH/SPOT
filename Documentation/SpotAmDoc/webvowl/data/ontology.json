  "classAttribute" : [ {
    "iri" : "https://w3id.org/spot/am#BoundaryPointMapping",
    "baseIri" : "https://w3id.org/spot/am",
    "instances" : 0,
    "label" : {
      "IRI-based" : "BoundaryPointMapping",
      "en" : "Boundary Point Mapping"
    },
    "comment" : {
      "en" : "The Boundary Point Mapping describes the relation of an Entity Axis Boundary Point (Source Point)\r\n        to the reference space. The relation can be expressed by Directional Properties of the RELOC Ontology\r\n        (e.g., containedInFront/Right/Bottom etc.) and/or as a Normalized Coordinate in relation to the reference space.\r\n        If both properties are given the the normalized coordinate is to be interpreted in the context of the area\r\n        defined by the RELOC Property (e.g., Point <reloc:containedInRight> RefSpace.\r\n        --> '0.5' describes the center of the Right Area of the Reference Space)"
    },
    "id" : "0"
  }, {
    "iri" : "https://w3id.org/spot/am#MaxBoundaryPoint",
    "baseIri" : "https://w3id.org/spot/am",
    "instances" : 0,
    "label" : {
      "IRI-based" : "MaxBoundaryPoint",
      "en" : "Maximum Boundary Point"
    },
    "comment" : {
      "en" : "A point that represents the maximum/upper boundary of an Entity Space on a specific Axis"
    },
    "id" : "1",
    "superClasses" : [ "2" ]
  }, {
