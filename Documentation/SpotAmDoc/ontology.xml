        <rdfs:comment xml:lang="en">A point that represents the maximum/upper boundary of an Entity Space on a specific Axis</rdfs:comment>
        <rdfs:label xml:lang="en">Maximum Boundary Point</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/spot/am#MinBoundaryPoint -->


